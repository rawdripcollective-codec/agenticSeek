# Copy this file to .env. Do not commit .env or real credentials.
WORK_DIR="/absolute/path/to/your/workspace"
SEARXNG_SECRET_KEY="generate-with-openssl-rand-hex-32"

# Bind services only to localhost by default. Use a reverse proxy with TLS for remote access.
FRONTEND_BIND_ADDRESS="127.0.0.1"
BACKEND_BIND_ADDRESS="127.0.0.1"
SEARXNG_BIND_ADDRESS="127.0.0.1"
BACKEND_PORT="7777"
BACKEND_LISTEN_HOST="0.0.0.0"
BACKEND_STARTUP_TIMEOUT="300"
REACT_APP_BACKEND_URL="http://localhost:7777"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Internal service and local model endpoints.
SEARXNG_BASE_URL="http://searxng:8080"
REDIS_BASE_URL="redis://redis:6379/0"
DOCKER_INTERNAL_URL="http://host.docker.internal"
OLLAMA_PORT="11434"
LM_STUDIO_PORT="1234"
CUSTOM_ADDITIONAL_LLM_PORT="11435"

# Provider credentials are optional and must be supplied only when that provider is selected.
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
MINIMAX_API_KEY=""
HUGGINGFACE_API_KEY=""
DSK_DEEPSEEK_API_KEY=""
